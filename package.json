{
  "name": "ci-cd-playwright-demo",
  "version": "1.0.0",
  "description": "Projeto de automação de testes com CI/CD — Pós-graduação PGTS",
  "scripts": {
    "start:app": "ts-node app/server.ts",
    "test": "playwright test",
    "test:local": "playwright test --config=playwright.local.config.ts",
    "test:public": "playwright test tests/public-api.spec.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "express": "^4.19.0"
  }
}
